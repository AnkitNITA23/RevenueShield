# ==============================================================================
# RevenueShield — Environment Configuration Template (.env.example)
# Classification: [REQUIRED] | [OPTIONAL] | [DEVELOPMENT-ONLY]
# NEVER COMMIT REAL PRODUCTION SECRETS TO GIT REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# [REQUIRED] Application runtime environment ('development', 'staging', 'production')
ENVIRONMENT=development

# [DEVELOPMENT-ONLY] Debug mode (set to False in staging/production)
DEBUG=True

# [REQUIRED] Server binding port and host
PORT=8000
HOST=0.0.0.0

# [REQUIRED] CORS allowed origin URLs (comma-separated). Do NOT use wildcard '*' with credentials in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# [REQUIRED] Primary relational database connection URL
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/revenue_recovery

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# [REQUIRED for Live Recovery] Razorpay API Key ID (e.g. rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=

# [REQUIRED for Live Recovery] Razorpay API Key Secret
RAZORPAY_KEY_SECRET=

# [REQUIRED for Webhook Verification] Secret configured in Razorpay Webhook dashboard
RAZORPAY_WEBHOOK_SECRET=

# [REQUIRED] Execution mode ('dry_run' for simulated gateway, 'razorpay_test' for test API, 'live' for real payments)
EXECUTION_MODE=dry_run

# ------------------------------------------------------------------------------
# 4. TWILIO VOICE & WHATSAPP CREDENTIALS
# ------------------------------------------------------------------------------
# [REQUIRED for Voice/WhatsApp Recovery] Twilio Account SID (e.g. AC...)
TWILIO_ACCOUNT_SID=

# [REQUIRED for Voice/WhatsApp Recovery] Twilio Primary Auth Token
TWILIO_AUTH_TOKEN=

# [REQUIRED for Voice Calls] Verified Twilio Phone Number in E.164 format (e.g. +14155552671)
TWILIO_PHONE_NUMBER=

# [REQUIRED for Twilio Webhooks] Public HTTPS base domain (e.g. https://api.yourdomain.com or Cloudflare Tunnel)
# Twilio will POST TwiML requests to ${TWILIO_WEBHOOK_BASE_URL}/webhooks/twilio/voice/...
TWILIO_WEBHOOK_BASE_URL=

# [OPTIONAL] Twilio Status Callback URL
TWILIO_STATUS_CALLBACK_URL=

# [OPTIONAL] Twilio WhatsApp Sender Number (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# [OPTIONAL] Sandbox WhatsApp Test Recipient
TWILIO_WHATSAPP_TO=

# [REQUIRED] Twilio communication provider toggle ('dry_run', 'development', 'twilio')
COMMUNICATION_MODE=twilio
TWILIO_WHATSAPP_MODE=SANDBOX
WHATSAPP_MODE=REAL

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL RECOVERY SERVICE
# ------------------------------------------------------------------------------
# [REQUIRED for Email Recovery] SMTP Relay Host (e.g. smtp.sendgrid.net, smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# [REQUIRED for Email Recovery] SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# [REQUIRED for Email Recovery] SMTP Username / Account
SMTP_USER=

# [REQUIRED for Email Recovery] SMTP Password / App Secret
SMTP_PASSWORD=

# [REQUIRED for Email Recovery] Outbound Sender Email Address
SMTP_FROM_EMAIL=recovery@yourdomain.com

# [OPTIONAL] Outbound Sender Display Name
SMTP_FROM_NAME=RevenueShield Recovery

# [OPTIONAL] Enable TLS encryption (True/False)
SMTP_USE_TLS=True

# ------------------------------------------------------------------------------
# 6. INTERNAL SERVER-TO-SERVER SECURITY & API PROTECTION
# ------------------------------------------------------------------------------
# [REQUIRED in Production] Secret token required for admin sync and sensitive test triggers
INTERNAL_API_SECRET=

# ------------------------------------------------------------------------------
# 7. MACHINE LEARNING & ATTRIBUTION ENGINE
# ------------------------------------------------------------------------------
# [OPTIONAL] Attribution window duration in hours for crediting recoveries
ATTRIBUTION_WINDOW_HOURS=72

# [OPTIONAL] Minimum sample count threshold before triggering automated retraining
RETRAINING_SCHEDULE_THRESHOLD=50

# ------------------------------------------------------------------------------
# 8. RECOVERY POLICY & DND SAFETY RULES
# ------------------------------------------------------------------------------
# [OPTIONAL] Channel attempt limits
MAX_VOICE_ATTEMPTS=3
MAX_WHATSAPP_ATTEMPTS=3
VOICE_COOLDOWN_MINUTES=60
WHATSAPP_COOLDOWN_MINUTES=1440

# [OPTIONAL] Do-Not-Disturb (DND) quiet hours (24h format)
DND_START_TIME=20:00
DND_END_TIME=08:00
DEFAULT_TIMEZONE=Asia/Kolkata
